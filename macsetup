#!/bin/bash
# macsetup -- declarative macOS setup with Nix
#
# Usage: macsetup <command> [args]
#
# Wraps darwin-rebuild with automatic generation management and a fail-safe
# update pipeline. Keeps the last 3 generations after every mutating operation.
#
# Must stay /bin/bash (3.2) compatible: `macsetup bootstrap` runs on a bare Mac.

set -euo pipefail

# ---------------------------------------------------------------------------
# Resolve repo root
# ---------------------------------------------------------------------------

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ ! -f "$REPO_ROOT/flake.nix" ]; then
  echo ""
  echo "ERROR: flake.nix not found at $REPO_ROOT/flake.nix"
  echo "Run this script from within the macsetup repository."
  echo ""
  exit 1
fi

# Determinate Nix releases before this one poll the daemon socket with
# select(), which macOS rejects with EINVAL once a file-descriptor number
# reaches 1024 -- the "polling file descriptor: Invalid argument" failure that
# kills rebuilds at random. Nix raises its own fd limit, so any large
# evaluation can trip it. 3.22.0 switched to poll().
DETERMINATE_NIX_MIN_OK="3.22.0"

# The system activation just switched to, and nix-homebrew's brew.
CURRENT_SYSTEM="/run/current-system"
HOMEBREW_BIN="/opt/homebrew/bin/brew"

# How long to wait for the Nix daemon to come back after an upgrade.
NIX_DAEMON_WAIT_TRIES=90
NIX_DAEMON_POLL_SECONDS=1

# Passed to every nix / darwin-rebuild call on this flake. The tree is dirty
# on purpose whenever macsetup builds it (update rewrites flake.lock before
# building, rebuild applies edits that are not committed yet), so Nix's "Git
# tree ... has uncommitted changes" says nothing new. The files flakes skip
# are the untracked ones, and those it never warns about.
NIX_FLAGS=(--option warn-dirty false)

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

info() {
  echo "==> $*"
}

warn() {
  echo "WARNING: $*" >&2
}

error() {
  echo "" >&2
  echo "ERROR: $*" >&2
  echo "" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Pure helpers (unit-tested by scripts/test-macsetup.sh)
# ---------------------------------------------------------------------------

# lock_diff OLD NEW -- print "input: oldrev -> newrev" for every input whose
# locked revision differs between two flake.lock files, sorted by input name.
lock_diff() {
  jq -r --slurpfile old "$1" '
    ($old[0].nodes) as $o
    | .nodes | to_entries[]
    | select((.value.locked.rev? // null) != null)
    | select(($o[.key].locked.rev? // null) != .value.locked.rev)
    | "\(.key): \(($o[.key].locked.rev? // "(new)")[:7]) -> \(.value.locked.rev[:7])"
  ' "$2" | sort
}

# dry_run_local_builds FILE -- from `nix build --dry-run` output, print the
# packages that would be compiled locally (no binary-cache hit). Glue
# derivations from nix-darwin / Home Manager (etc files, activation scripts,
# ...) carry no version number and are skipped, as is nix-homebrew's brew
# patch step, which is always local and trivial.
dry_run_local_builds() {
  awk '
    /will be built:?[[:space:]]*$/ { building = 1; next }
    /will be fetched/              { building = 0 }
    building && /^[[:space:]]*\/nix\/store\// {
      name = $1
      sub(/^\/nix\/store\/[a-z0-9]+-/, "", name)
      sub(/\.drv$/, "", name)
      print name
    }
  ' "$1" \
    | grep -E -- '-[0-9]' \
    | grep -v -E '^(darwin-system-|etc-|hm_|hm-|brew-[0-9][^ ]*-patched$)' \
    || true
}

# heavy_builds -- filter stdin (one package per line) down to the toolchains
# and runtimes that take hours to compile on a laptop and that nixpkgs
# normally serves prebuilt. Seeing one means the binary cache has not caught
# up with the new nixpkgs pin yet.
heavy_builds() {
  grep -E '^(dotnet-|llvm-[0-9]|clang-[0-9]|gcc-[0-9]|rustc-[0-9]|cargo-[0-9]|go-[0-9]|nodejs-[0-9]|python3-[0-9]|openjdk-[0-9]|ghc-[0-9]|swift-[0-9]|qtbase-[0-9]|webkitgtk-[0-9]|chromium-[0-9]|electron-[0-9]|texlive-|boost-[0-9])' \
    || true
}

# is_transient_nix_error LOG -- true when the log shows the Determinate Nix
# < 3.22 daemon-socket bug rather than a real evaluation/build failure.
is_transient_nix_error() {
  grep -q 'polling file descriptor: Invalid argument' "$1" 2>/dev/null
}

# version_lt A B -- true when dotted version A sorts before B.
version_lt() {
  [ "$1" != "$2" ] \
    && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -n1)" = "$1" ]
}

# parse_determinate_versions FILE -- from `determinate-nixd version` output,
# print "<daemon> <latest>"; latest falls back to daemon when none is advertised.
parse_determinate_versions() {
  local daemon latest
  daemon="$(sed -n 's/^Determinate Nixd daemon version: *//p' "$1" | head -n1)"
  latest="$(sed -n 's/^Latest version: *//p' "$1" | head -n1)"
  [ -n "$daemon" ] || return 1
  echo "$daemon ${latest:-$daemon}"
}

# brew_tail_matches BIN_BREW VENDORED -- true when VENDORED (nix-homebrew's
# modules/brew.tail.sh) ends with BIN_BREW's tail, cut the way nix-homebrew's
# scripts/update-brew-tail.sh cuts it: everything after the HOMEBREW_LIBRARY=
# line, with nix-homebrew's runtime PATH put in front. The header nix-homebrew
# writes above the tail is not compared.
brew_tail_matches() {
  local tail vendored
  tail="$(sed -e '1,/^HOMEBREW_LIBRARY=/d' -e 's/^PATH="/PATH="@runtimePath@:/' "$1" 2>/dev/null)" || return 1
  vendored="$(cat "$2" 2>/dev/null)" || return 1
  [ -n "$tail" ] && [[ "$vendored" == *$'\n'"$tail" ]]
}

# outdated_names JSON KIND -- from `brew outdated --json=v2` output, the
# outdated formulae or casks (KIND: formulae | casks) that `brew upgrade`
# acts on, i.e. not pinned, one per line, sorted for comm.
outdated_names() {
  jq -r --arg kind "$2" '.[$kind][]? | select(.pinned | not) | .name' "$1" 2>/dev/null \
    | LC_ALL=C sort || true
}

# count_lines FILE -- how many lines FILE has.
count_lines() {
  awk 'END { print NR }' "$1"
}

# packages N -- "1 package", "N packages".
packages() {
  if [ "$1" -eq 1 ]; then echo "1 package"; else echo "$1 packages"; fi
}

# name_list MAX -- stdin's lines as "a, b, c", or the first MAX of them
# followed by "and N more".
name_list() {
  awk -v max="$1" '
    NR <= max { list = list (NR > 1 ? ", " : "") $0 }
    END { if (NR > max) list = list " and " (NR - max) " more"; print list }
  '
}

# brew_dsl_errors LOG... -- the errors in brew output that mean Homebrew is
# older than the taps it reads: Ruby rejecting formula or cask DSL it does not
# know yet (2026-08-13 "unknown keyword: :network_access", 2026-10-21
# "undefined method 'new' for an instance of Symbol"), as opposed to a failed
# download or build. Each distinct line once, in order.
brew_dsl_errors() {
  grep -h -E '^Error: .*(is unreadable|undefined method|unknown keyword|wrong number of arguments|uninitialized constant)' \
    "$@" 2>/dev/null | awk '!seen[$0]++' || true
}

# brew_skew_advice DSL_ERRORS RERUN -- say why brew_dsl_errors output means
# the pinned Homebrew is older than the taps it reads, and how to fix it;
# RERUN is the command to run afterwards. Warnings, on stderr.
brew_skew_advice() {
  local pin
  pin="$(brew_src_pin)"
  warn "Cause: ${pin:-the pinned Homebrew} (brew-src in flake.nix) is older than the taps it reads:"
  printf '%s\n' "$1" | sed 's/^/    /' >&2
  warn "Fix: pin brew-src to the latest Homebrew/brew release, then run: $2"
}

# brewfile_names BREWFILE KIND -- the names BREWFILE declares as KIND (brew |
# cask), one per line in file order, exactly as written (tap prefix and
# @version included). Options, comments, taps and App Store apps are not names.
brewfile_names() {
  sed -n "s/^$2 \"\\([^\"]*\\)\".*/\\1/p" "$1" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Repo helpers
# ---------------------------------------------------------------------------

gc() {
  sudo nix-env -p /nix/var/nix/profiles/system --delete-generations +3 2>/dev/null
  sudo nix-collect-garbage &>/dev/null
}

# Detect the darwin configuration name: use hostname if a matching host file
# exists, otherwise fall back to the legacy "macsetup" entry.
config_name() {
  local hostname
  hostname="$(hostname -s)"
  if [[ -f "$REPO_ROOT/hosts/${hostname}.nix" ]]; then
    echo "$hostname"
  else
    echo "macsetup"
  fi
}

# Ensure user.nix is staged so the Nix flake can see it (flakes ignore
# unstaged files). This is a no-op when user.nix does not exist yet.
stage_user_nix() {
  if [[ -f "$REPO_ROOT/user.nix" ]]; then
    git -C "$REPO_ROOT" add -f user.nix 2>/dev/null || true
  fi
}

# nix flake update, authenticated against GitHub when gh is logged in, so the
# dozen github: inputs do not exhaust the 60/hour anonymous API limit after a
# couple of retries.
flake_update() {
  local token=""
  if command -v gh >/dev/null 2>&1; then
    token="$(gh auth token 2>/dev/null || true)"
  fi
  if [ -n "$token" ]; then
    NIX_CONFIG="access-tokens = github.com=$token
${NIX_CONFIG:-}" nix flake update "${NIX_FLAGS[@]}" "$@"
  else
    nix flake update "${NIX_FLAGS[@]}" "$@"
  fi
}

# brew_src_pin [LOCK] -- the Homebrew release that flake.lock (or LOCK) pins
# as brew-src, e.g. Homebrew/brew/7.0.10; nothing when it pins none.
brew_src_pin() {
  jq -r '.nodes."brew-src".original | select(. != null) | "\(.owner)/\(.repo)/\(.ref // .rev)"' \
    "${1:-$REPO_ROOT/flake.lock}" 2>/dev/null || true
}

# locked_input_path NAME -- the store path of github input NAME at the
# revision flake.lock pins (fetched on first use, cached after); prints
# nothing when it cannot be fetched.
locked_input_path() {
  local ref
  ref="$(jq -r --arg name "$1" \
    '.nodes[$name].locked | select(.type == "github") | "github:\(.owner)/\(.repo)/\(.rev)"' \
    "$REPO_ROOT/flake.lock" 2>/dev/null || true)"
  [ -n "$ref" ] || return 0
  nix flake prefetch --json "$ref" 2>/dev/null | jq -r '.storePath // empty' 2>/dev/null || true
}

# restore_lock WORKDIR -- put the pre-update flake.lock back, keeping the
# rejected one next to it for bisecting.
restore_lock() {
  cp "$REPO_ROOT/flake.lock" "$1/flake.lock.after"
  cp "$1/flake.lock.before" "$REPO_ROOT/flake.lock"
  warn "flake.lock restored to the previous pins; the rejected lock is at $1/flake.lock.after"
}

# ---------------------------------------------------------------------------
# sudo handling
# ---------------------------------------------------------------------------

SUDO_KEEPALIVE_PID=""
SUDO_STARTED=false

# Ask once, right away, and keep that one approval alive for the whole run so
# a long build never ends in a second prompt that nobody is there to answer.
# sudo ties an approval to this terminal session, so only commands macsetup
# runs itself, directly, can reuse it (see run_logged sudo-tty and
# appstore_upgrade). brew revokes it before it first uses sudo (utils/sudo.sh;
# before brew 7.0.8, brew.sh at every start), which is why finish_switch runs
# Homebrew last. sudo_stop revokes it: nothing outlives the run.
sudo_start() {
  info "sudo is needed once for this run; the approval is revoked when macsetup exits."
  sudo -v || error "sudo authentication failed"
  SUDO_STARTED=true
  ( while sleep 60; do sudo -n -v 2>/dev/null || exit 0; done ) &
  SUDO_KEEPALIVE_PID=$!
}

# Safe to call more than once: the EXIT trap calls it again after
# homebrew_upgrade, which may have taken an approval of its own.
sudo_stop() {
  if [ -n "$SUDO_KEEPALIVE_PID" ]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    SUDO_KEEPALIVE_PID=""
  fi
  if [ "$SUDO_STARTED" = true ]; then
    sudo -k 2>/dev/null || true
  fi
}

trap sudo_stop EXIT

# ---------------------------------------------------------------------------
# Running nix with a log and a retry for the known transient failure
# ---------------------------------------------------------------------------

# run_logged MODE LOG CMD... -- run CMD, capturing all output to LOG.
#   tty:      CMD runs on a pseudo-terminal, so nix keeps its progress bar.
#   sudo-tty: as tty, with CMD running as root. sudo goes outside `script`:
#             script starts a new terminal session, where sudo would ask for
#             approval again instead of reusing sudo_start's.
#   quiet:    output goes to LOG only (the last lines are shown on failure).
# When the failure is the transient daemon-socket bug, the command is retried.
run_logged() {
  local mode="$1" log="$2"
  shift 2
  local attempt ok
  for attempt in 1 2 3; do
    ok=true
    case "$mode" in
      tty)      script -q -t 0 "$log" "$@" || ok=false ;;
      sudo-tty) sudo script -q -t 0 "$log" "$@" || ok=false ;;
      quiet)    "$@" >"$log" 2>&1 || ok=false ;;
    esac
    if [ "$ok" = true ]; then
      return 0
    fi
    if [ "$attempt" -lt 3 ] && is_transient_nix_error "$log"; then
      warn "Nix hit the transient daemon-socket bug (attempt $attempt of 3); retrying..."
      warn "Permanent fix: Determinate Nix $DETERMINATE_NIX_MIN_OK or later ('macsetup update' upgrades it)"
      continue
    fi
    if [ "$mode" = quiet ]; then
      tail -n 30 "$log" >&2
    fi
    return 1
  done
  return 1
}

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------

# determinate_nix_versions -- print "<daemon> <latest>" as reported by
# determinate-nixd; fails when it is not installed or says nothing usable.
determinate_nix_versions() {
  command -v determinate-nixd >/dev/null 2>&1 || return 1
  local tmp versions
  tmp="$(mktemp)"
  determinate-nixd version >"$tmp" 2>/dev/null || true
  versions="$(parse_determinate_versions "$tmp" || true)"
  rm -f "$tmp"
  [ -n "$versions" ] || return 1
  echo "$versions"
}

# Warn when Determinate Nix is behind; fail (after warning) when it still has
# the daemon-socket bug that aborts rebuilds at random.
check_determinate_nix() {
  local versions daemon latest
  versions="$(determinate_nix_versions)" || return 0
  daemon="${versions%% *}"
  latest="${versions##* }"
  if version_lt "$daemon" "$DETERMINATE_NIX_MIN_OK"; then
    warn "Determinate Nix $daemon can abort any rebuild with 'polling file descriptor: Invalid argument'"
    warn "(select() on a file descriptor >= 1024; fixed in $DETERMINATE_NIX_MIN_OK)."
    warn "'macsetup update' upgrades it automatically, or run: sudo determinate-nixd upgrade"
    return 1
  fi
  if version_lt "$daemon" "$latest"; then
    warn "Determinate Nix $daemon is behind the latest release ($latest); 'macsetup update' upgrades it."
  fi
  return 0
}

# nix-homebrew's brew wrapper ends with a copy of the tail of Homebrew's own
# bin/brew, taken from the release nix-homebrew pins, while flake.nix
# overrides that release (brew-src) so the taps' DSL can be newer than
# nix-homebrew's lag. That only works while the pinned release has the same
# bin/brew tail; otherwise every Ruby-backed brew command dies during
# activation (2026-09-22: KeyError on HOMEBREW_ORIGINAL_BREW_FILE, brew 6.0.17
# under a 7.0.4 tail). A newer release with an unchanged bin/brew is fine
# (2026-10-21: 7.0.10 under the 7.0.4 tail). Silently skips when either
# side cannot be fetched.
check_brew_src_pin() {
  local ours rev brew_src nix_homebrew theirs
  ours="$(brew_src_pin)"
  [ -n "$ours" ] || return 0
  rev="$(jq -r '.nodes."nix-homebrew".locked.rev // empty' "$REPO_ROOT/flake.lock" 2>/dev/null || true)"
  [ -n "$rev" ] || return 0
  brew_src="$(locked_input_path brew-src)"
  nix_homebrew="$(locked_input_path nix-homebrew)"
  [ -n "$brew_src" ] && [ -f "$brew_src/bin/brew" ] || return 0
  [ -n "$nix_homebrew" ] && [ -f "$nix_homebrew/modules/brew.tail.sh" ] || return 0
  theirs="$(brew_src_pin "$nix_homebrew/flake.lock")"
  theirs="${theirs:-its own brew-src pin}"
  if ! brew_tail_matches "$brew_src/bin/brew" "$nix_homebrew/modules/brew.tail.sh"; then
    warn "brew-src $ours has a different bin/brew tail than the one nix-homebrew ${rev:0:7} vendors (from $theirs)."
    warn "Activation would fail. In flake.nix pin brew-src to $theirs (or a release with the same bin/brew) and re-run."
    return 1
  fi
  info "brew-src $ours matches the bin/brew tail nix-homebrew vendors (from $theirs)."
}

# A switch whose activation aborted still advances the system profile, so the
# running system silently falls behind. Catch that instead of stacking
# generations on top of a failure nobody noticed.
check_activation_state() {
  local current profile
  current="$(readlink /run/current-system 2>/dev/null || true)"
  profile="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
  [ -n "$current" ] && [ -n "$profile" ] || return 0
  if [ "$current" != "$profile" ]; then
    warn "The latest generation ($(basename "$profile")) never finished activating;"
    warn "the running system is still $(basename "$current"). Fix the cause, then: macsetup rebuild"
    return 1
  fi
  info "Running system matches the latest generation."
}

# dry_run_report CFG LOG ALLOW_HEAVY -- evaluate the configuration and list
# what would be compiled locally. Fails on an evaluation error, or when a
# multi-hour toolchain build is pending and not explicitly allowed.
dry_run_report() {
  local cfg="$1" log="$2" allow_heavy="$3"
  local local_builds heavy
  info "Checking what .#$cfg would build locally..."
  run_logged quiet "$log" nix build --dry-run --no-link "${NIX_FLAGS[@]}" ".#darwinConfigurations.$cfg.system" \
    || return 1
  local_builds="$(dry_run_local_builds "$log")"
  if [ -z "$local_builds" ]; then
    info "Everything comes from the binary cache; nothing to compile locally."
    return 0
  fi
  info "Not in the binary cache, will compile locally:"
  # shellcheck disable=SC2086  # one name per line, no spaces or globs
  printf '    %s\n' $local_builds
  heavy="$(printf '%s\n' "$local_builds" | heavy_builds)"
  [ -n "$heavy" ] || return 0
  if [ "$allow_heavy" = true ]; then
    warn "Proceeding with multi-hour builds because --allow-heavy-builds was given."
    return 0
  fi
  warn "These are multi-hour toolchain builds -- the binary cache has not caught up with this nixpkgs yet:"
  # shellcheck disable=SC2086
  printf '    %s\n' $heavy >&2
  warn "Options: try again in a day or two; update everything except nixpkgs"
  warn "(macsetup update home-manager nix-darwin homebrew-core homebrew-cask ...);"
  warn "or force it with: macsetup update --allow-heavy-builds"
  return 1
}

# nix_homebrew_parts SYSTEM -- what the built SYSTEM installs as Homebrew, one
# per line: the brew source tree, the taps, and the brew wrapper. They are the
# symlink lines of nix-homebrew's setup-homebrew, which SYSTEM's activate
# script runs. Fails when SYSTEM has no such script or its lines changed shape.
# shellcheck disable=SC2016  # the $ in the sed patterns is setup-homebrew's own text
nix_homebrew_parts() {
  local setup code taps wrapper
  setup="$(grep -m1 -E '^/[^[:space:]]*-setup-homebrew$' "$1/activate" 2>/dev/null)" || return 1
  code="$(sed -n 's|^/bin/ln -shf "\(.*\)/Library/Homebrew" "\$HOMEBREW_LIBRARY/Homebrew"$|\1|p' "$setup" 2>/dev/null)"
  taps="$(sed -n 's|^/bin/ln -shf "\([^"]*\)" "\$HOMEBREW_LIBRARY/Taps"$|\1|p' "$setup" 2>/dev/null)"
  wrapper="$(sed -n 's|^/bin/ln -shf "\([^"]*\)" "\$BIN_BREW"$|\1|p' "$setup" 2>/dev/null)"
  [ -n "$code" ] && [ -n "$taps" ] && [ -n "$wrapper" ] || return 1
  printf '%s\n%s\n%s\n' "$code" "$taps" "$wrapper"
}

# scratch_homebrew DIR CODE TAPS WRAPPER LIVE -- a throwaway Homebrew prefix at
# DIR/prefix that runs the brew a new system will install, without installing
# it: Library/Homebrew and Library/Taps are the new build's, and bin/brew is
# nix-homebrew's wrapper rewired to this prefix. LIVE, the real prefix, only
# lends Cellar, Caskroom, opt and var/homebrew, which `brew info` reads and
# never writes. Brew loads an installed package from its own copy of the
# definition once the tap has dropped it (homebrew-core moved azure-cli to a
# cask), and activation relies on that, so the check has to see what is
# installed here.
scratch_homebrew() {
  local dir="$1" code="$2" taps="$3" wrapper="$4" live="$5" p d
  p="$dir/prefix"
  mkdir -p "$p/bin" "$p/var" "$p/Library/.homebrew-is-managed-by-nix/.git"
  : > "$p/Library/.homebrew-is-managed-by-nix/.git/HEAD"
  ln -s "$code/Library/Homebrew" "$p/Library/Homebrew"
  ln -s "$taps" "$p/Library/Taps"
  for d in Cellar Caskroom opt; do
    if [ -e "$live/$d" ]; then ln -s "$live/$d" "$p/$d"; fi
  done
  if [ -e "$live/var/homebrew" ]; then ln -s "$live/var/homebrew" "$p/var/homebrew"; fi
  sed -e "s|^export HOMEBREW_PREFIX=.*|export HOMEBREW_PREFIX=\"$p\"|" \
      -e "s|^export HOMEBREW_LIBRARY=.*|export HOMEBREW_LIBRARY=\"$p/Library\"|" \
      -e "s|^export HOMEBREW_BREW_FILE=.*|export HOMEBREW_BREW_FILE=\"$p/bin/brew\"|" \
      "$wrapper" >"$p/bin/brew"
  chmod +x "$p/bin/brew"
}

# preflight_homebrew SYSTEM [RERUN] -- before the built SYSTEM is activated,
# let the Homebrew it installs read every formula and cask its Brewfile
# declares. Activation runs `brew bundle` and macsetup then runs `brew
# upgrade`, and both die at a definition their brew cannot parse. That has
# happened four times: the taps adopt new DSL before the pinned brew (brew-src)
# knows it. On 2026-11-03 (`zap :not_required`) it happened in the middle of
# activation, with half of the Brewfile installed. This runs in a scratch
# prefix (scratch_homebrew), so nothing is installed or changed.
#
# Fails only on the errors brew_dsl_errors recognises, the ones whose fix is
# the brew-src pin; RERUN is the command the advice ends with. Anything else
# (a package the taps lost, brew itself failing) only warns: restoring the
# lock would not fix it, and refusing to update over it would block every
# update. Skips, with a warning, when the system's setup-homebrew cannot be
# found.
#
# The check runs with HOMEBREW_NO_REQUIRE_TAP_TRUST because trust is
# `brew bundle`'s job (it records the Brewfile's entries, see homebrew.nix),
# so a tap added to the config would otherwise fail here until the first
# activation. brew 7 deprecates the variable; it is only set for this
# read-only scratch prefix, never for real brew runs.
preflight_homebrew() {
  local system="$1" rerun="${2:-macsetup update}"
  local brewfile parts code taps wrapper dir kind label names n dsl
  local counts="" failed=false
  local args=()
  brewfile="$(activated_brewfile "$system")"
  [ -n "$brewfile" ] || return 0
  if ! parts="$(nix_homebrew_parts "$system")"; then
    warn "Cannot find the new Homebrew in the built system; skipping the Homebrew check."
    return 0
  fi
  { read -r code; read -r taps; read -r wrapper; } <<<"$parts"

  dir="$(mktemp -d -t macsetup-preflight)"
  scratch_homebrew "$dir" "$code" "$taps" "$wrapper" "$(dirname "$(dirname "$HOMEBREW_BIN")")"
  for kind in formula cask; do
    names="$(brewfile_names "$brewfile" "$([ "$kind" = formula ] && echo brew || echo cask)")"
    [ -n "$names" ] || continue
    args=()
    while IFS= read -r n; do args+=("$n"); done <<<"$names"
    case "$kind:${#args[@]}" in
      formula:1) label=formula ;;
      formula:*) label=formulae ;;
      cask:1)    label=cask ;;
      *)         label=casks ;;
    esac
    counts="${counts:+$counts, }${#args[@]} $label"
    if ! (
      export HOMEBREW_TEMP="$dir/tmp" HOMEBREW_CACHE="$dir/cache" HOMEBREW_LOGS="$dir/logs"
      export HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_REQUIRE_TAP_TRUST=1
      HOMEBREW_BIN="$dir/prefix/bin/brew" brew_noninteractive info --json=v2 "--$kind" "${args[@]}"
    ) >"$dir/$kind.json" 2>"$dir/$kind.err"; then
      failed=true
    fi
  done

  if [ "$failed" = false ]; then
    info "Homebrew: the new brew reads all of the Brewfile's packages ($counts)."
    rm -rf "$dir"
    return 0
  fi
  dsl="$(brew_dsl_errors "$dir/formula.err" "$dir/cask.err" | head -n 3)"
  if [ -n "$dsl" ]; then
    warn "The Homebrew this configuration installs cannot read the Brewfile's packages; activating it would fail on them."
    brew_skew_advice "$dsl" "$rerun"
    warn "Homebrew's output is kept in $dir"
    return 1
  fi
  warn "macsetup could not finish the Homebrew check (not an error that restoring the lock would fix, so carrying on):"
  cat "$dir/formula.err" "$dir/cask.err" 2>/dev/null \
    | grep -v '^Warning: Calling HOMEBREW_NO_REQUIRE_TAP_TRUST' | tail -n 5 | sed 's/^/    /' >&2 || true
  rm -rf "$dir"
}

# ---------------------------------------------------------------------------
# Upgrades that ride along with update and rebuild
# ---------------------------------------------------------------------------

# upgrade_determinate_nix -- move Determinate Nix to the release Determinate
# Systems currently advises, before the rest of an update runs on it. Needs
# sudo_start first. A failed upgrade (offline, server trouble) only warns:
# the update carries on with the installed version.
upgrade_determinate_nix() {
  local versions daemon latest
  versions="$(determinate_nix_versions)" || return 0
  daemon="${versions%% *}"
  latest="${versions##* }"
  if ! version_lt "$daemon" "$latest"; then
    info "Determinate Nix $daemon is the latest release."
    return 0
  fi
  info "Upgrading Determinate Nix $daemon -> $latest..."
  if ! sudo determinate-nixd upgrade; then
    warn "Determinate Nix upgrade failed; continuing on $daemon."
    return 0
  fi
  if ! wait_for_determinate_nix "$latest"; then
    warn "The Nix daemon did not come back on $latest within ${NIX_DAEMON_WAIT_TRIES}s; continuing."
    return 0
  fi
  info "Determinate Nix is now $latest."
}

# wait_for_determinate_nix VERSION -- block until the daemon reports VERSION
# and answers store requests. `determinate-nixd upgrade` returns before
# launchd restarts the daemon: on 2026-10-05 it came back 21 s later and took
# the `nix flake update` that had already started down with it.
wait_for_determinate_nix() {
  local want="$1" tries="$NIX_DAEMON_WAIT_TRIES" versions
  while [ "$tries" -gt 0 ]; do
    versions="$(determinate_nix_versions || true)"
    if [ "${versions%% *}" = "$want" ] && nix store info >/dev/null 2>&1; then
      return 0
    fi
    sleep "$NIX_DAEMON_POLL_SECONDS"
    tries=$((tries - 1))
  done
  return 1
}

# The `brew bundle` line in the activated system's activate script, and what
# it names: the Brewfile, and the mas that nix-darwin puts on its PATH (mas is
# not on the user's PATH).
activation_bundle_line() {
  grep -m1 'brew bundle --file=' "${1:-$CURRENT_SYSTEM}/activate" 2>/dev/null || true
}

# The Brewfile of SYSTEM (default: the running one).
activated_brewfile() {
  activation_bundle_line "${1:-}" | sed -n "s/.*brew bundle --file='\([^']*\)'.*/\1/p"
}

activated_mas() {
  local dir
  dir="$(activation_bundle_line | sed -n 's/^[[:space:]]*PATH="\([^"]*\)".*/\1/p' | tr ':' '\n' \
    | grep -E -- '-mas-[^/]*/bin$' | head -n1 || true)"
  if [ -n "$dir" ] && [ -x "$dir/mas" ]; then
    echo "$dir/mas"
  fi
}

# appstore_upgrade -- update the Mac App Store apps the Brewfile declares.
# mas needs root for this and reuses this session's sudo approval, so it has
# to run while macsetup still holds one -- before homebrew_upgrade, since
# brew revokes it. A failed update only warns.
appstore_upgrade() {
  local brewfile ids mas
  brewfile="$(activated_brewfile)"
  [ -n "$brewfile" ] || return 0
  ids="$(sed -n 's/^mas .*, id: *\([0-9][0-9]*\).*/\1/p' "$brewfile" 2>/dev/null | tr '\n' ' ' || true)"
  [ -n "${ids// /}" ] || return 0
  mas="$(activated_mas)"
  if [ -z "$mas" ]; then
    warn "No mas in the activated system; skipping App Store updates."
    return 0
  fi
  [ -n "$("$mas" outdated 2>/dev/null || true)" ] || return 0
  info "Updating App Store apps..."
  # shellcheck disable=SC2086  # one numeric app ID per word
  "$mas" update $ids || warn "Some App Store updates failed; retry with: $mas update"
}

# brew_noninteractive ARGS... -- brew the way macsetup runs it, at the end of
# a run nobody may be watching: no auto-update (the taps are flake inputs), no
# env hints (brew 7 explains its auto_updates-cask behaviour on every run), and
# no "Do you want to proceed?" (brew 7 asks by default whenever stdin and
# stdout are terminals).
brew_noninteractive() {
  HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_ASK=1 "$HOMEBREW_BIN" "$@"
}

# brew_outdated FILE -- `brew outdated --json=v2` into FILE, its stderr into
# FILE.err; fails unless brew answered with JSON.
brew_outdated() {
  brew_noninteractive outdated --json=v2 >"$1" 2>"$1.err" && jq -e . "$1" >/dev/null 2>&1
}

# What homebrew_upgrade left undone, for the closing line of rebuild and
# update; empty when everything went through.
HOMEBREW_SHORTFALL=""

# homebrew_upgrade -- upgrade the outdated Homebrew formulae, then the
# outdated casks, one `brew upgrade` process each, and say plainly what was
# not upgraded. Not one process for both: brew abandons the whole run at the
# first formula it cannot load, so on 2026-10-21 one unreadable formula kept
# every cask (every app) from upgrading too. Not one process per package
# either: brew revokes this session's sudo approval before it first uses sudo,
# so `brew bundle`, which starts one per cask, asked again for each cask with
# a root installer. Formula upgrades never use sudo, so only the casks'
# process can ask, and at most once. Only for systems whose activation manages
# Homebrew. Never fails the caller -- the system is already switched -- but
# sets HOMEBREW_SHORTFALL when something was left behind.
homebrew_upgrade() {
  local dir kind n note dsl counted=false total=0 left failed=""
  [ -x "$HOMEBREW_BIN" ] || return 0
  if [ -z "$(activated_brewfile)" ]; then
    warn "Activation does not run brew bundle; skipping Homebrew upgrades."
    return 0
  fi
  dir="$(mktemp -d -t macsetup-brew)"
  if brew_outdated "$dir/before.json"; then
    counted=true
    for kind in formulae casks; do
      outdated_names "$dir/before.json" "$kind" >"$dir/$kind.before"
      total=$((total + $(count_lines "$dir/$kind.before")))
    done
    if [ "$total" -eq 0 ]; then
      info "Homebrew packages are all up to date."
      rm -rf "$dir"
      return 0
    fi
  else
    warn "brew outdated failed, so macsetup cannot tell what gets upgraded:"
    tail -n 5 "$dir/before.json.err" >&2
  fi

  for kind in formulae casks; do
    n=""
    if [ "$counted" = true ]; then
      n="$(count_lines "$dir/$kind.before")"
      [ "$n" -gt 0 ] || continue
    fi
    note="${n:+$n outdated}"
    [ "$kind" = formulae ] || note="${note:+$note; }Homebrew asks for sudo itself if one needs root"
    info "Upgrading Homebrew $kind${note:+ ($note)}..."
    brew_noninteractive upgrade "--$kind" 2>&1 | tee "$dir/$kind.log" || failed="$failed $kind"
  done

  if [ "$counted" = true ] && brew_outdated "$dir/after.json"; then
    for kind in formulae casks; do
      outdated_names "$dir/after.json" "$kind" | LC_ALL=C comm -12 "$dir/$kind.before" -
    done >"$dir/left"
    left="$(count_lines "$dir/left")"
    if [ "$left" -eq 0 ]; then
      info "Homebrew: upgraded $(packages "$total"), nothing left outdated."
    elif [ "$left" -eq "$total" ]; then
      HOMEBREW_SHORTFALL="nothing was upgraded"
      warn "Homebrew upgraded nothing: $(packages "$total") still outdated."
    else
      HOMEBREW_SHORTFALL="$left of $total outdated packages not upgraded"
      warn "Homebrew upgraded $((total - left)) of $total outdated packages. Not upgraded: $(name_list 8 <"$dir/left")."
    fi
  fi
  if [ -z "$HOMEBREW_SHORTFALL" ] && [ -n "$failed" ]; then
    HOMEBREW_SHORTFALL="brew upgrade reported errors"
    warn "brew upgrade reported errors (${failed# }); see above."
  fi
  if [ -z "$HOMEBREW_SHORTFALL" ]; then
    rm -rf "$dir"
    return 0
  fi

  dsl="$(brew_dsl_errors "$dir"/*.log "$dir"/*.err | head -n 3)"
  if [ -n "$dsl" ]; then
    brew_skew_advice "$dsl" "macsetup rebuild"
  else
    warn "Retry with: brew upgrade"
  fi
  warn "Homebrew logs: $dir"
  return 0
}

# finish_switch -- everything after a successful activation, in the only order
# that keeps it to one approval: what needs macsetup's approval first, then
# revoke it, then Homebrew, which revokes approvals itself.
finish_switch() {
  appstore_upgrade
  gc
  sudo_stop
  homebrew_upgrade
}

# finished WHAT -- the closing line of rebuild and update: plain success, or
# what Homebrew left undone, so a partial upgrade does not read as a clean one.
finished() {
  if [ -n "$HOMEBREW_SHORTFALL" ]; then
    warn "$1 complete, except Homebrew: $HOMEBREW_SHORTFALL (details above)."
  else
    info "$1 complete."
  fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
macsetup -- declarative macOS setup with Nix

Usage: macsetup <command> [args]

Commands:
  bootstrap     First-time setup (install Nix + nix-darwin) [--force]
  rebuild       Apply configuration changes (darwin-rebuild switch), then
                upgrade App Store and Homebrew packages. Builds first and
                checks that Homebrew can read every package in the Brewfile;
                if not, nothing is activated.
  update        Upgrade Determinate Nix when a newer release exists, update
                flake inputs, build, then switch and upgrade App Store and
                Homebrew packages. If the new inputs fail to evaluate or
                build, or the new Homebrew cannot read the new taps (checked
                before activating), flake.lock is restored and the system is
                left untouched.
                  [input...]             update only these inputs
                  --build-only           update + build, do not switch
                  --allow-heavy-builds   allow multi-hour toolchain builds
  upgrade       Alias for update
  doctor        Check for the usual causes of failed rebuilds
  rollback      Revert to the previous generation
  switch N      Switch to generation N
  list          Show generation history
  capture       Audit current Mac and import unmanaged items

Options:
  -h, --help    Show this help message

After rebuild, update, rollback, and switch, old generations are
automatically pruned (keeping the last 3) and garbage collected.

rebuild and update ask for sudo once, at the start, and revoke the approval
when done. Homebrew revokes sudo approvals before it uses sudo, so it may ask
once more at the very end, only when an app with a root installer updates.
EOF
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_bootstrap() {
  local force=false
  if [ "${1:-}" = "--force" ] || [ "${1:-}" = "-f" ]; then
    force=true
  fi
  if [ "$force" = false ] && command -v darwin-rebuild &>/dev/null; then
    error "This Mac has already been bootstrapped (darwin-rebuild found). Use 'macsetup bootstrap --force' to re-run anyway."
  fi
  if [ ! -f "$REPO_ROOT/scripts/bootstrap.sh" ]; then
    error "bootstrap.sh not found at $REPO_ROOT/scripts/bootstrap.sh"
  fi
  if [ "$force" = true ]; then
    exec "$REPO_ROOT/scripts/bootstrap.sh" --force
  else
    exec "$REPO_ROOT/scripts/bootstrap.sh"
  fi
}

cmd_rebuild() {
  stage_user_nix
  local cfg work
  cfg="$(config_name)"
  cd "$REPO_ROOT"
  check_determinate_nix || true
  check_brew_src_pin || error "Fix the brew-src pin in flake.nix before rebuilding."
  # darwin-rebuild builds and activates in one go, so build first (as the user;
  # the switch below finds it cached) and let the new brew read the Brewfile
  # before anything is activated.
  work="$(mktemp -d -t macsetup-rebuild)"
  info "Building the system configuration (.#$cfg)..."
  run_logged tty "$work/build.log" nix build --out-link "$work/system" "${NIX_FLAGS[@]}" ".#darwinConfigurations.$cfg.system" \
    || error "The configuration does not build; nothing was changed on this Mac. Full log: $work/build.log"
  if ! preflight_homebrew "$work/system" "macsetup rebuild"; then
    rm -rf "$work"  # the build was fine; Homebrew's own output is kept by the check
    error "Homebrew cannot read the packages this configuration declares; nothing was changed on this Mac."
  fi
  sudo_start
  info "Rebuilding system configuration (.#$cfg)..."
  if ! run_logged sudo-tty "$work/switch.log" darwin-rebuild switch --flake ".#$cfg" "${NIX_FLAGS[@]}"; then
    error "Rebuild failed. Full log: $work/switch.log"
  fi
  finish_switch
  rm -rf "$work"
  finished Rebuild
}

cmd_update() {
  local build_only=false allow_heavy=false
  local inputs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --build-only)         build_only=true ;;
      --allow-heavy-builds) allow_heavy=true ;;
      -*)                   error "Unknown option for update: $1" ;;
      *)                    inputs+=("$1") ;;
    esac
    shift
  done

  stage_user_nix
  local cfg work changes
  cfg="$(config_name)"
  cd "$REPO_ROOT"

  if [ "$build_only" = true ]; then
    check_determinate_nix || true
  else
    sudo_start
    upgrade_determinate_nix
  fi

  work="$(mktemp -d -t macsetup-update)"
  cp flake.lock "$work/flake.lock.before"

  info "Updating flake inputs${inputs[*]+ (${inputs[*]})}..."
  flake_update ${inputs[@]+"${inputs[@]}"} \
    || error "nix flake update failed; flake.lock is unchanged."

  changes="$(lock_diff "$work/flake.lock.before" flake.lock)"
  if [ -z "$changes" ]; then
    info "All inputs were already up to date."
  else
    info "Updated inputs:"
    # shellcheck disable=SC2001  # multi-line value; sed is the readable option
    echo "$changes" | sed 's/^/    /'
  fi

  # From here until activation, any failure restores the previous flake.lock:
  # the machine stays on the known-good pins and nothing is half-applied.
  if ! check_brew_src_pin; then
    restore_lock "$work"
    error "Fix the brew-src pin in flake.nix, then re-run 'macsetup update'."
  fi
  if ! dry_run_report "$cfg" "$work/dry-run.log" "$allow_heavy"; then
    restore_lock "$work"
    error "Update aborted before building anything. Logs: $work"
  fi

  info "Building the new system configuration (as $USER; sudo comes later)..."
  if ! run_logged tty "$work/build.log" nix build --out-link "$work/system" "${NIX_FLAGS[@]}" ".#darwinConfigurations.$cfg.system"; then
    restore_lock "$work"
    error "The updated inputs do not build; nothing was changed on this Mac. Full log: $work/build.log"
  fi

  # Building proves Nix can evaluate the new inputs, not that the new Homebrew
  # can read the new taps. Find that out now, not in the middle of activation.
  if ! preflight_homebrew "$work/system" "macsetup update"; then
    restore_lock "$work"
    error "The updated taps are too new for the pinned Homebrew; nothing was changed on this Mac. Logs: $work"
  fi

  if [ "$build_only" = true ]; then
    rm -rf "$work"
    info "Build succeeded. flake.lock now holds the new pins; run 'macsetup rebuild' to activate them."
    return 0
  fi

  info "Activating (.#$cfg)..."
  if ! run_logged sudo-tty "$work/switch.log" darwin-rebuild switch --flake ".#$cfg" "${NIX_FLAGS[@]}"; then
    error "Activation failed after a successful build, so this is an activation-time problem (usually Homebrew).
Full log:        $work/switch.log
Retry with:      macsetup rebuild
Or go back with: cp $work/flake.lock.before flake.lock && macsetup rebuild"
  fi
  finish_switch
  rm -rf "$work"
  finished Update
}

cmd_doctor() {
  stage_user_nix
  local cfg log status=0
  cfg="$(config_name)"
  cd "$REPO_ROOT"
  info "Configuration: .#$cfg"
  check_determinate_nix || status=1
  check_activation_state || status=1
  check_brew_src_pin || status=1
  if ! git -C "$REPO_ROOT" diff --quiet -- flake.lock; then
    warn "flake.lock has uncommitted changes (an update that was never committed, or one that failed)."
  fi
  log="$(mktemp)"
  dry_run_report "$cfg" "$log" false || status=1
  rm -f "$log"
  if [ "$status" -eq 0 ]; then
    info "No problems found."
  else
    warn "Problems found -- see above."
  fi
  return "$status"
}

cmd_rollback() {
  info "Rolling back to previous generation..."
  sudo darwin-rebuild --rollback
  gc
  info "Rollback complete."
}

cmd_switch() {
  local gen="$1"
  if ! [[ "$gen" =~ ^[1-9][0-9]*$ ]]; then
    error "Invalid generation number: $gen (must be a positive integer)"
  fi
  info "Switching to generation $gen..."
  sudo darwin-rebuild --switch-generation "$gen"
  gc
  info "Switched to generation $gen."
}

cmd_list() {
  sudo darwin-rebuild --list-generations
}

cmd_capture() {
  if ! command -v darwin-rebuild &>/dev/null; then
    error "This Mac has not been bootstrapped yet. Run 'macsetup bootstrap' first."
  fi
  if [ ! -f "$REPO_ROOT/scripts/capture.sh" ]; then
    error "capture.sh not found at $REPO_ROOT/scripts/capture.sh"
  fi
  exec "$REPO_ROOT/scripts/capture.sh" "$@"
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 1
  fi

  case "$1" in
    bootstrap)
      cmd_bootstrap "${2:-}"
      ;;
    rebuild)
      cmd_rebuild
      ;;
    update|upgrade)
      shift
      cmd_update "$@"
      ;;
    doctor)
      cmd_doctor
      ;;
    rollback)
      cmd_rollback
      ;;
    switch)
      if [ $# -lt 2 ]; then
        error "Usage: macsetup switch <generation-number>"
      fi
      cmd_switch "$2"
      ;;
    list)
      cmd_list
      ;;
    capture)
      shift
      cmd_capture "$@"
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Unknown command: $1"
      echo ""
      usage
      exit 1
      ;;
  esac
}

# Only dispatch when executed; scripts/test-macsetup.sh sources this file.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
